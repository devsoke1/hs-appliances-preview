# Optional: Google reCAPTCHA v3 SITE key (public). Leave empty to disable.
# The matching SECRET key goes in config.php on the server, never here.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Optional: Google Analytics 4 measurement ID. Loaded only after cookie consent.
# Leave empty = no analytics and no cookie banner.
NEXT_PUBLIC_GA4_ID=

# Optional: Google Search Console HTML-tag verification code (the content="..." value only).
NEXT_PUBLIC_GSC_VERIFICATION=
