# /uploads — images only. Nothing in here can ever run as code.
Options -Indexes -ExecCGI
DirectoryIndex disabled

# Remove any script handlers that might be inherited
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps .cgi .pl .py .asp .aspx .jsp .sh
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

# Whitelist: deny everything, then allow only image files
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<FilesMatch "^[A-Za-z0-9._-]+\.(webp|jpe?g|png)$">
  Require all granted
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'none'; script-src 'none'; sandbox"
  <FilesMatch "\.(webp|jpe?g|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
