# ─────────────────────────────────────────────────────────────────────────────
#  hsappliances.co.uk — static Next.js export + PHP form handlers
#  Hostinger Single Web Hosting (LiteSpeed; Apache-compatible .htaccess)
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes -MultiViews
DirectoryIndex index.html index.php
AddDefaultCharset UTF-8

ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ───────────────────────────── MIME types ─────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript      .js .mjs
  AddType application/json            .json
  AddType application/manifest+json   .webmanifest
  AddType image/svg+xml               .svg
  AddType image/webp                  .webp
  AddType image/avif                  .avif
  AddType font/woff2                  .woff2
  AddType text/plain                  .txt
  AddType application/xml             .xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── 1. Block sensitive files (before anything else) ──
  # Dotfiles (.git, .env, .user.ini, .htaccess…) except /.well-known/ (SSL validation)
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  # Internal PHP library and runtime data
  RewriteRule ^api/_(lib|data)(/|$) - [F,L]
  RewriteRule ^api/db\.php$ - [F,L]
  # Admin internals and PHP page templates
  RewriteRule ^hs-admin/_inc(/|$) - [F,L]
  RewriteRule ^includes(/|$) - [F,L]
  # Uploads: images only, never scripts (also enforced by uploads/.htaccess)
  RewriteCond %{REQUEST_URI} ^/uploads/
  RewriteCond %{REQUEST_URI} !\.(webp|jpe?g|png)$ [NC]
  RewriteRule ^ - [F,L]
  # Config files anywhere
  RewriteRule (^|/)config(\.example)?\.php$ - [F,L]
  # Backups, logs, source and package files
  RewriteRule \.(env|ini|log|sh|sql|bak|old|orig|swp|dist|lock|eml|md|ts|tsx|map)$ - [F,L,NC]
  RewriteRule (^|/)(composer|package(-lock)?)\.json$ - [F,L,NC]

  # ── 2. Canonical host: HTTPS + www ──
  RewriteCond %{HTTP_HOST} ^hsappliances\.co\.uk$ [NC]
  RewriteRule ^ https://www.hsappliances.co.uk%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── 3. Renamed pages ──
  RewriteRule ^faqs/?$ /faq/ [L,R=301]
  # "Blog" is now "Insights"
  RewriteRule ^blog/?$ /insights/ [L,R=301]
  RewriteRule ^blog/(.+?)/?$ /insights/$1/ [L,R=301]
  RewriteRule ^services/gas-cooker-repair/?$ /domestic/ [L,R=301]
  RewriteRule ^services/gas-hob-repair/?$ /domestic/ [L,R=301]
  RewriteRule ^gas-cooker/?$ /domestic/ [L,R=301]
  RewriteRule ^gas-hob/?$ /domestic/ [L,R=301]

  # ── 3b. PHP-rendered pages (live from the database) ──
  # Renamed service/post slugs and real 404s are handled inside the PHP pages.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^(services|insights)$ /$1/ [L,R=301]
  RewriteRule ^(services|insights)/([a-z0-9-]+)$ /$1/$2/ [L,R=301]
  RewriteRule ^services/$ services/index.php [L]
  RewriteRule ^services/([a-z0-9-]+)/$ services/service.php?slug=$1 [L,QSA]
  RewriteRule ^insights/$ insights/index.php [L,QSA]
  RewriteRule ^insights/([a-z0-9-]+)/$ insights/post.php?slug=$1 [L,QSA]

  # ── 4. Clean URLs for the static export (trailingSlash: true) ──
  # /about/index.html → /about/   and   /index.html → /
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # /about → /about/  (only when the folder has an index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

# ───────────────────────────── Compression ─────────────────────────────
# LiteSpeed compresses automatically; these apply on Apache.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ───────────────────────────── Caching ─────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                              "access plus 1 hour"
  ExpiresByType text/html                     "access plus 0 seconds"
  ExpiresByType text/plain                    "access plus 0 seconds"
  ExpiresByType application/json              "access plus 0 seconds"
  ExpiresByType application/xml               "access plus 1 day"
  ExpiresByType text/xml                      "access plus 1 day"
  ExpiresByType text/css                      "access plus 1 year"
  ExpiresByType application/javascript        "access plus 1 year"
  ExpiresByType font/woff2                    "access plus 1 year"
  ExpiresByType image/svg+xml                 "access plus 1 month"
  ExpiresByType image/png                     "access plus 1 month"
  ExpiresByType image/jpeg                    "access plus 1 month"
  ExpiresByType image/webp                    "access plus 1 month"
  ExpiresByType image/avif                    "access plus 1 month"
  ExpiresByType image/x-icon                  "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # All JS/CSS/fonts live in /_next/static/ with content-hashed names → safe to cache forever
  <FilesMatch "\.(js|mjs|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages and RSC payloads: always revalidate so deploys show up immediately
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>

  # ───────────────────────────── Security headers ─────────────────────────────
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # CSP: Next.js static export needs inline scripts/styles. Google domains = Maps embed, optional reCAPTCHA, optional GA4 (after consent).
  # If something breaks after a change, swap to "Content-Security-Policy-Report-Only" and check the browser console.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.gstatic.com https://*.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.google.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src https://www.google.com https://maps.google.com https://recaptcha.google.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
