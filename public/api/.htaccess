# /api — only the public endpoints may be requested (forms + read-only JSON). db.php, config.php, _lib/ are denied.
Options -Indexes
DirectoryIndex disabled

# Deny everything in this folder by default (config.php, config.example.php, .user.ini, logs…)
<FilesMatch ".*">
  Require all denied
</FilesMatch>

# …then allow just the endpoints. (Later sections override earlier ones.)
<FilesMatch "^(contact|booking|availability|services|reviews|posts)\.php$">
  Require all granted
</FilesMatch>

<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(contact|booking|availability|services|reviews|posts)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
